#!/usr/bin/python3
"""Create desktop launchers pointing to selected local files or folders."""
import shutil
import subprocess
import sys
from pathlib import Path


def get_desktop() -> Path:
    result = subprocess.run(
        ["xdg-user-dir", "DESKTOP"], capture_output=True, text=True, check=False
    )
    candidate = result.stdout.strip()
    return Path(candidate).expanduser() if result.returncode == 0 and candidate else Path.home() / "Desktop"


def unique_path(path: Path) -> Path:
    if not path.exists():
        return path
    for number in range(2, 10000):
        candidate = path.with_name(f"{path.stem} ({number}){path.suffix}")
        if not candidate.exists():
            return candidate
    raise RuntimeError("Could not find an unused shortcut name")


def desktop_escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace("\n", "\\n").replace("\r", "\\r")


def create_shortcut(source: Path, desktop: Path) -> None:
    source = source.expanduser().absolute()
    if not source.exists():
        print(f"Skipping missing path: {source}", file=sys.stderr)
        return

    if source.is_file() and source.suffix.lower() == ".desktop":
        target = unique_path(desktop / source.name)
        shutil.copy2(source, target)
        target.chmod(target.stat().st_mode | 0o111)
    else:
        target = unique_path(desktop / f"{source.name or 'Root'} - Shortcut.desktop")
        uri = source.as_uri().replace("%", "%%")
        name = desktop_escape(f"{source.name or str(source)} - Shortcut")
        content = (
            "[Desktop Entry]\n"
            "Version=1.0\n"
            "Type=Application\n"
            f"Name={name}\n"
            f'Exec=xdg-open "{uri}"\n'
            "Icon=folder\n"
            "Terminal=false\n"
        )
        target.write_text(content, encoding="utf-8")
        target.chmod(0o755)

    subprocess.run(
        ["gio", "set", str(target), "metadata::trusted", "true"],
        capture_output=True,
        check=False,
    )
    print(f"Created shortcut: {target}")


def main() -> int:
    if len(sys.argv) < 2:
        print("Usage: send-to-desktop FILE_OR_FOLDER [...]", file=sys.stderr)
        return 2
    desktop = get_desktop()
    desktop.mkdir(parents=True, exist_ok=True)
    failed = False
    for item in sys.argv[1:]:
        try:
            create_shortcut(Path(item), desktop)
        except Exception as exc:
            failed = True
            print(f"Could not create shortcut for {item!r}: {exc}", file=sys.stderr)
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
